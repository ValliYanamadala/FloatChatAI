# Application Settings
PROJECT_NAME="FloatChatAI — ARGO Oceanographic Float Intelligence System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# PostgreSQL + PostGIS Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="argo_user"
POSTGRES_PASSWORD="argo_password"
POSTGRES_DB="argo_db"

# Optional Direct SQLAlchemy Database URLs
DATABASE_URL="postgresql://argo_user:argo_password@localhost:5432/argo_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://argo_user:argo_password@localhost:5432/argo_db"

# Model Context Protocol (MCP) Server Configuration
FLOATCHAT_BACKEND_URL="http://localhost:8000"

# FloatChatAI RAG & Vector Store Configuration
CHROMA_PATH="./data/chroma"
CHROMA_PORT=8001
RAG_COLLECTION_NAME="floatchat_knowledge"
RAG_VECTOR_STORE="memory"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"

# AI & LLM Provider Configuration
AI_PROVIDER="auto"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL="gpt-4o-mini"
